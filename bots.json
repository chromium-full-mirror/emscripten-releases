{
  "linux": {
    "build_steps": [
      {
        "name": "Build Binaryen",
        "command": ["waterfall/src/build.py", "--no-sync", "--no-test", "--build-include=binaryen"]
      },
      {
        "name": "Build LLVM",
        "command": ["waterfall/src/build.py", "--no-sync", "--no-test", "--build-include=llvm"]
      },
      {
        "name": "Build fastcomp",
        "command": ["waterfall/src/build.py", "--no-sync", "--no-test", "--build-include=fastcomp"]
      },
      {
        "name": "Build Emscripten (upstream)",
        "command": ["waterfall/src/build.py", "--no-sync", "--no-test", "--build-include=emscripten-upstream"]
      },
      {
        "name": "Build Emscripten (fastcomp)",
        "command": ["waterfall/src/build.py", "--no-sync", "--no-test", "--build-include=emscripten-fastcomp"]
      }
    ],
    "test_steps": [
      {
        "name": "Emscripten testsuite (upstream, wasms)",
        "command": ["waterfall/src/build.py", "--no-sync", "--no-build",
                    "--test-include=emtest", "--test-param=wasms"]
      },
      {
        "name": "Emscripten testsuite (upstream, wasm3)",
        "command": ["waterfall/src/build.py", "--no-sync", "--no-build",
                    "--test-include=emtest", "--test-param=wasm3"]
      },
      {
        "name": "Emscripten testsuite (upstream, other)",
        "command": ["waterfall/src/build.py", "--no-sync", "--no-build",
                    "--test-include=emtest",
                    "--test-param=other,skip:other.test_minimal_runtime_code_size"]
      }
    ]
  },
