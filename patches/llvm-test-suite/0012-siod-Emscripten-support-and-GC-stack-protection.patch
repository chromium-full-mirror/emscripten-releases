@@ -80,6 +80,34 @@ gjc@world.std.com
 #include "siod.h"
 #include "siodp.h"
 
+LISP lprin1(LISP obj, LISP stream);
+
+#ifdef __EMSCRIPTEN__
+#include <stdint.h>
+#include <emscripten.h>
+
+struct gc_stack_root {
+    LISP *location;
+    struct gc_stack_root *next;
+};
+
+struct gc_stack_root *gc_stack_roots = NULL;
+
+#define GC_STACK_PROTECT(_x) struct gc_stack_root _root_##_x = { (LISP*)&(_x), gc_stack_roots }; gc_stack_roots = &_root_##_x
+#define GC_STACK_UNPROTECT(_x) gc_stack_roots = _root_##_x.next
+
+void siod_em_scan_callback(void* start, void* end) {
+    uintptr_t s = (uintptr_t)start;
+    uintptr_t e = (uintptr_t)end;
+    if (s > e) { uintptr_t t = s; s = e; e = t; }
+    s = (s + 3) & ~3;
+    e = e & ~3;
+    if (s < e) {
+        mark_locations_array((LISP*)s, (e - s) / 4);
+    }
+}
+#endif
